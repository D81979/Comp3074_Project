<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    tools:context=".PointsFormActivity">

    <!-- Grey header from the wireframe. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#DDDDDD"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:contentDescription="Go back"
            android:focusable="true"
            android:gravity="center"
            android:text="&lt;"
            android:textColor="#444444"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Point"
            android:textColor="#444444"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Scroll when the keyboard opens or the screen is small. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="36dp">

            <!-- Name field. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:labelFor="@id/etPointName"
                android:text="Name"
                android:textColor="#444444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPointName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/form_field_border"
                android:backgroundTint="@null"
                android:hint="Point name"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="#444444"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <!-- Address field. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etAddress"
                android:text="Address"
                android:textColor="#444444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/form_field_border"
                android:backgroundTint="@null"
                android:hint="Street, city"
                android:inputType="textPostalAddress"
                android:maxLines="1"
                android:paddingHorizontal="12dp"
                android:textColor="#444444"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <!-- Taller box for the task. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/etTask"
                android:text="Task / Instructions"
                android:textColor="#444444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etTask"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/form_field_border"
                android:backgroundTint="@null"
                android:gravity="top|start"
                android:hint="What should the player do?"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="12dp"
                android:textColor="#444444"
                android:textColorHint="#999999"
                android:textSize="14sp" />

            <!-- Small rectangular tags. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="TAGs"
                android:textColor="#444444"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEasy"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="easy"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#DDDDDD"
                    app:chipCornerRadius="0dp"
                    app:chipMinHeight="28dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHard"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hard"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#DDDDDD"
                    app:chipCornerRadius="0dp"
                    app:chipMinHeight="28dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPhoto"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="photo"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#DDDDDD"
                    app:chipCornerRadius="0dp"
                    app:chipMinHeight="28dp"
                    app:chipStrokeWidth="0dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipInfo"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="info"
                    android:textColor="#444444"
                    android:textSize="12sp"
                    app:chipBackgroundColor="#DDDDDD"
                    app:chipCornerRadius="0dp"
                    app:chipMinHeight="28dp"
                    app:chipStrokeWidth="0dp" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Plain rectangular button for a custom tag. -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAddTag"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="#DDDDDD"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:text="+ Add new tag"
                android:textAllCaps="false"
                android:textColor="#444444"
                android:textSize="12sp"
                app:backgroundTint="@null" />

            <!-- Keep the action buttons near the bottom. -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="64dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSavePoint"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#444444"
                android:text="Save Point"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/form_cancel_border"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#444444"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>