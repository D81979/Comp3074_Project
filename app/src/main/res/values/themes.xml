<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ScavengerHunt" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/dark</item>
        <item name="colorPrimaryDark">@color/dark</item>
        <item name="colorSecondary">@color/dark</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Theme.ScavengerHunt.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">@color/white</item>

        <item name="windowSplashScreenAnimatedIcon">
            @android:drawable/ic_menu_mapmode
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.ScavengerHunt
        </item>

    </style>

</resources>